TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token
OWNER_TELEGRAM_ID=123456789
TIMEZONE=Europe/Moscow
DATABASE_URL=sqlite+aiosqlite:///./data/olymping.db
DATA_DIR=data/calendar
CTFTIME_SYNC_INTERVAL_HOURS=6
CTFTIME_LOOKAHEAD_DAYS=180
REMINDER_POLL_SECONDS=60
REMINDER_GRACE_HOURS=24
LOG_LEVEL=INFO
# Docker Compose limits (not preallocated memory).
BOT_MEMORY_LIMIT=384m
BACKUP_MEMORY_LIMIT=64m
